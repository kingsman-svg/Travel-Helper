# 配置模板。已有 .env 时无需覆盖；密钥仅在本机服务端填写。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
KNOWLEDGE_MIN_SCORE=0.50
KNOWLEDGE_EXAMPLES_PATH=./knowledge-data

BACKEND_PORT=8080
MCP_PORT=8081
FRONTEND_PORT=5173
MCP_BASE_URL=http://127.0.0.1:8081
MCP_ENDPOINT=/mcp
AMAP_API_KEY=

# 路径相对于项目根目录，由启动脚本统一工作目录。
TRAVEL_DATA_DIR=./.data
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_TIMEOUT_SECONDS=90
MODEL_TIMEOUT_SECONDS=90
